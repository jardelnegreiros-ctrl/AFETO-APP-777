  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@lembre-me/shared/*": ["packages/shared/types/index.ts"],
      "@lembre-me/config/*": ["packages/config/index.ts"]
    }
  }
}